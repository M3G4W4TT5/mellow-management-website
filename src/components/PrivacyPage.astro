---
import {PrivacyView} from './SiteView';
import PageHead from './PageHead.astro';
import '../styles/site.css';
import {getContent,type Locale} from '../lib/content';
const {locale}=Astro.props as {locale:Locale};
const content=await getContent();
---
<!doctype html><html lang={locale}><head><PageHead content={content} locale={locale} privacy/></head><body class="legal-page"><PrivacyView content={content} locale={locale}/></body></html>
