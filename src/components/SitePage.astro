---
import ArtistBrowser from './ArtistBrowser';
import ContactForm from './ContactForm.astro';
import { localized, type Locale, type SiteContent } from '../lib/content';
import '../styles/site.css';

const { locale, content } = Astro.props as { locale: Locale; content: SiteContent };
const da = locale === 'da';
const home = da ? '/' : '/en/';
const alternate = da ? '/en/' : '/';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#DF597D" />
    <meta name="description" content={localized(content.intro, locale)} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://mellowmanagement.com${home}`} />
    <link rel="alternate" hreflang="da" href="https://mellowmanagement.com/" />
    <link rel="alternate" hreflang="en" href="https://mellowmanagement.com/en/" />
    <title>Mellow Management — {da ? 'Artister' : 'Artists'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{da ? 'Spring til indhold' : 'Skip to content'}</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label="Mellow Management — home">
        <img src="/mellow-logo.webp" alt="Mellow Management" width="166" height="52" />
      </a>
      <nav class="site-nav" aria-label={da ? 'Hovedmenu' : 'Main navigation'}>
        <a href="#artists">{da ? 'Artister' : 'Artists'}</a>
        <a href="#contact">{da ? 'Kontakt' : 'Contact'}</a>
        <a class="language-switch" href={alternate} lang={da ? 'en' : 'da'} aria-label={da ? 'View in English' : 'Se på dansk'}>{da ? 'EN' : 'DK'} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__top"><span>{da ? 'Musik med noget på hjerte' : 'Music with something to say'}</span><span>CPH · DK</span></div>
        <h1 id="hero-title">Mellow<br /><em>Management<span class="hero__asterisk">✳</span></em></h1>
        <div class="hero__bottom"><p>{localized(content.intro, locale)}</p><a href="#artists" class="hero__scroll">{da ? 'Mød artisterne' : 'Meet the artists'} <span aria-hidden="true">↓</span></a></div>
        <div class="hero__stamp" aria-hidden="true">GOOD<br />MUSIC<br />FIRST</div>
      </section>

      <section class="artists-section" id="artists" aria-labelledby="artists-heading">
        <div class="section-heading"><span class="micro-label">01 / {da ? 'Artister' : 'Artists'}</span><span class="section-heading__rule"></span><span>{String(content.artists.length).padStart(2, '0')} {da ? 'navne' : 'names'}</span></div>
        <h2 id="artists-heading">{da ? 'Vores artister.' : 'Our artists.'}</h2>
        <p class="artists-section__intro">{da ? 'Hver deres lyd. Hver deres historie.' : 'Each with their own sound. Each with their own story.'}</p>
        <ArtistBrowser artists={content.artists} locale={locale} client:load />
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="section-heading"><span class="micro-label">02 / {da ? 'Kontakt' : 'Contact'}</span><span class="section-heading__rule"></span></div>
        <div class="contact-section__grid">
          <div class="contact-section__intro"><h2 id="contact-heading">{localized(content.contactTitle, locale)}</h2><p>{localized(content.contactText, locale)}</p><a class="contact-section__email" href={`mailto:${content.contactEmail}`}>{content.contactEmail} ↗</a></div>
          <ContactForm locale={locale} siteKey={siteKey} />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__name">MELLOW<br />MANAGEMENT<span>®</span></div>
      <div class="site-footer__info"><span>CVR 35347380</span><span>Åboulevard 32, 2. tv<br />2200 København N, Danmark</span><a href={`mailto:${content.contactEmail}`}>{content.contactEmail}</a></div>
      <div class="site-footer__links"><a href={da ? '/privatliv/' : '/en/privacy/'}>{da ? 'Privatliv' : 'Privacy'}</a><a href="https://www.instagram.com/mellowmgmt/" target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href="#main">{da ? 'Til toppen' : 'Back to top'} ↑</a></div>
      <div class="site-footer__bottom"><span>© {new Date().getFullYear()} Mellow Management</span><span>{da ? 'God musik skabes af mennesker.' : 'Great music is made by people.'}</span></div>
    </footer>
  </body>
</html>
