---
import ArtistBrowser from './ArtistBrowser';
import ArrowUpRight from './ArrowUpRight';
import HeroCollage from './HeroCollage';
import ContactForm from './ContactForm.astro';
import { localized, type Locale, type SiteContent } from '../lib/content';
import '../styles/site.css';

const { locale, content } = Astro.props as { locale: Locale; content: SiteContent };
const da = locale === 'da';
const home = da ? '/' : '/en/';
const alternate = da ? '/en/' : '/';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const contactFormReady = import.meta.env.PUBLIC_CONTACT_FORM_READY === '1';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#DF597D" />
    <meta name="description" content={localized(content.intro, locale)} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`https://mellowmanagement.com${home}`} />
    <link rel="alternate" hreflang="da" href="https://mellowmanagement.com/" />
    <link rel="alternate" hreflang="en" href="https://mellowmanagement.com/en/" />
    <title>Mellow Management — {da ? 'Artister' : 'Artists'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{da ? 'Spring til indhold' : 'Skip to content'}</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label="Mellow Management — home">
        <img src="/mellow-logo.webp" alt="Mellow Management" width="166" height="52" />
      </a>
      <nav class="site-nav" aria-label={da ? 'Hovedmenu' : 'Main navigation'}>
        <a href="#artists">{da ? 'Artister' : 'Artists'}</a>
        <a href="#contact">{da ? 'Kontakt' : 'Contact'}</a>
        <a class="language-switch" href={alternate} lang={da ? 'en' : 'da'} aria-label={da ? 'View in English' : 'Se på dansk'}>{da ? 'EN' : 'DK'} <ArrowUpRight /></a>
      </nav>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__title-wrap"><h1 id="hero-title"><span>Mellow</span><span>Management</span></h1></div>
        <HeroCollage artists={content.artists} locale={locale} client:load />
        <div class="hero__bottom"><p>{localized(content.intro, locale)}</p><a href="#artists" class="hero__scroll">{da ? 'Mød artisterne' : 'Meet the artists'} <span aria-hidden="true">↘</span></a></div>
      </section>

      <div class="artist-ticker" aria-hidden="true"><div class="artist-ticker__track">{[0, 1].map(() => content.artists.map((artist) => <span>{artist.name}<img src="/mellow-lips.png" alt="" /></span>))}</div></div>

      <section class="artists-section" id="artists" aria-labelledby="artists-heading">
        <h2 id="artists-heading">{da ? 'Vores artister.' : 'Our artists.'}</h2>
        <p class="artists-section__intro">{da ? 'Hver deres lyd. Hver deres historie.' : 'Each with their own sound. Each with their own story.'}</p>
        <ArtistBrowser artists={content.artists} locale={locale} client:load />
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-heading">
        <div class="contact-section__grid">
          <div class="contact-section__intro"><h2 id="contact-heading">{localized(content.contactTitle, locale)}</h2><p>{localized(content.contactText, locale)}</p><a class="contact-section__email" href={`mailto:${content.contactEmail}`}>{content.contactEmail} <ArrowUpRight /></a></div>
          <ContactForm locale={locale} siteKey={siteKey} enabled={contactFormReady} />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="site-footer__name"><img src="/mellow-logo.webp" alt="Mellow Management" width="360" height="113" /><span>®</span></div>
      <div class="site-footer__info"><span>CVR 35347380</span><span>Åboulevard 32, 2. tv<br />2200 København N, Danmark</span><a href={`mailto:${content.contactEmail}`}>{content.contactEmail}</a></div>
      <div class="site-footer__links"><a href={da ? '/privatliv/' : '/en/privacy/'}>{da ? 'Privatliv' : 'Privacy'}</a><a href="#main">{da ? 'Til toppen' : 'Back to top'} ↑</a></div>
      <div class="site-footer__bottom"><span>© {new Date().getFullYear()} Mellow Management</span></div>
    </footer>
  </body>
</html>
