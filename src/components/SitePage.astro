---
import SiteView from './SiteView';
import PageHead from './PageHead.astro';
import '../styles/site.css';
import type {Locale,SiteContent} from '../lib/content-model';
const {locale,content}=Astro.props as {locale:Locale;content:SiteContent};
---
<!doctype html><html lang={locale}><head><PageHead content={content} locale={locale}/></head><body><SiteView content={content} locale={locale} client:load/></body></html>
